# ตัวอย่างตัวแปรสภาพแวดล้อมสำหรับ docker compose
# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# ----------------------------------------------------------------------------
# ERP catalog sync
# ----------------------------------------------------------------------------
# API key ที่ ERP ใช้เรียก GET /api/catalog ผ่าน header X-API-Key
# ไม่ตั้งค่า = endpoint ตอบ 503 (ปิดบริการ) ซึ่งเป็นค่าเริ่มต้นที่ปลอดภัย
# สร้างค่าสุ่มด้วย:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ERP_API_KEY=

# โดเมนที่อนุญาตให้เรียก API ข้าม origin คั่นด้วย comma
# ตัวอย่าง: https://erp.example.com,https://erp2.example.com
# ไม่ตั้ง = "*" (เปิดหมด ไม่แนะนำใน production)
CORS_ALLOW_ORIGINS=
